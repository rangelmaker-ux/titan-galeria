# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — ver README.md > "Configurando o R2"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=
R2_BUCKET_PUBLIC=
R2_PUBLIC_BASE_URL=
R2_PUBLIC_HOSTNAME=

# Stripe — ver README.md > "Configurando o Stripe"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL do site em produção (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Drive — guarda os arquivos ORIGINAIS em alta resolução (os previews
# com marca d'água continuam no R2). Ver README.md > "Configurando o Google Drive"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Stripe — assinatura SaaS (o fotógrafo pagando a Titan Galeria, separado do
# checkout que o cliente final paga pelas fotos). Ver README.md > "Configurando
# o Stripe (assinaturas)"
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_ESTUDIO=
